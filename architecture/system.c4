specification {
  element actor
  element system
  element service
  element store
}
model {
  guest = actor 'Гость' { description 'Выбирает санаторий на карте, затем даты и номер; создаёт заявку, оплачивает в симуляторе и оставляет отзыв после проживания.' }
  admin = actor 'Администратор' { description 'Создаёт санатории, настраивает каталог, назначает управляющих.' }
  manager = actor 'Управляющий' { description 'Управляет каталогом, заявками, отзывами и историей всех санаториев, закреплённых за его аккаунтом.' }
  accountant = actor 'Бухгалтер' { description 'Глобальный финансовый кабинет: поступления, возвраты, расходы, документы, аналитика и read-only план размещения. Не управляет каталогом или аккаунтами.' }
  operator = actor 'Оператор платформы' { description 'Активный Django staff-superuser; просматривает общую БД в технической консоли. Обычный администратор/управляющий этого доступа не получает.' }
  native = system 'Тыныс — iOS гостя' { description 'Capacitor 8 + Vue public routes, dist/mobile, kz.tynys.booking. Каталог/карта, брони, профиль; без страниц сотрудников. Native API через HTTPS /api/v1; токены в Keychain, PDF через Share. Default demo; dev-установка/запуск на iPhone 13 проверены, облачный API не подключён.' }
  nativeStaff = system 'Тыныс Команда — iOS сотрудников' { description 'Отдельный Capacitor bundle kz.tynys.staff, dist/mobile-staff. Обзор, брони, аналитика, управление; карточки на телефоне. Staff native credentials и отдельный sandbox. Default demo, данные не синхронизируются с гостевым demo.' }
  frontend = system 'Тыныс — Vue 3' {
    description 'Vue 3, Pinia, Vue Router, Vite и FSD. Отдельные public/staff сборки и адреса; combined для локальной разработки. vue-i18n RU/KK/EN. Общие FSD-компоненты используются в двух отдельных Capacitor iOS приложениях; Android ещё не добавлен.'
    discovery = service 'Категории и карта' { description 'pages/catalog + widgets/public-header: поиск без дат, каталог по умолчанию; плавающая кнопка открывает модальную карту и загружает Leaflet.' }
    guestAuth = service 'Вход гостя по телефону' { description 'pages/guest-auth + entities/guest-account: регистрация, пароль, demo OTP, сброс, выход. Аккаунты сотрудников имеют отдельную модель и вход.' }
    localization = service 'RU / KK / EN' { description 'shared/i18n: vue-i18n, JSON namespaces, сохранённый выбор языка, формат дат/денег. Контент объектов остаётся языком автора; тесты ключей, placeholders и компиляции.' }
    profiles = service 'Профили санатория и номера' { description 'pages/resort-profile, pages/room-profile: даты после выбора санатория, класс, описание, фото/видео, тарифы и отзывы; widgets/availability-calendar показывает ночи выбранного класса или конкретного номера и непрерывный доступный срок.' }
    bookingsPage = service 'Мои бронирования' { description 'pages/my-bookings: заявки гостевой сессии, временное удержание, автоматическое оформление по demo-оплате, расчёт возврата, отмена и отзыв.' }
    guestProfile = service 'Профиль, аватар и квитанции' { description 'pages/guest-profile, receipt, staff-guest: история и загрузка аватара зарегистрированного гостя; подтверждённый телефон нельзя редактировать без новой проверки. Сотрудник видит гостя своего объекта. PDF по действию пользователя.' }
    analyticsPage = service 'Аналитика сотрудников' { description 'pages/analytics: периоды и сравнение, дни/недели/месяцы, заявки, поступления/возвраты по источникам demo/sandbox/production, отзывы и разрезы.' }
    staffPage = service 'Кабинет сотрудников' { description 'pages/workspace + pages/login: план размещения по номерам/датам, карточка проживания, обзор, каталог, аккаунты, модерация/ответы и история. pages/clients: admin-only реестр гостей, история и versioned отключение аккаунта с отзывом сессий. Обязательный Resort.account: один ответственный аккаунт, много санаториев. WhatsApp onboarding через Бекасыл Админ. Тарифы убраны из staff UI; ручная бронь по сезонной цене номера.' }
    accountingPage = service 'Кабинет бухгалтера' { description 'pages/accounting: глобальный бухгалтер платформы, финансовая сводка, расходы/void, XLSX и CSV, реестр с пагинацией, отдельные demo/sandbox/production, реквизиты и версии документов. widgets/guest-documents выдаёт собственные опубликованные PDF/XLSX.' }
    occupancy = service 'План размещения' { description 'widgets/occupancy-board + entities/booking/model/occupancy: календарь 7/14/30 дней, поиск, фактические статусы пребывания, read-only финансовый snapshot, staff-only notes. Выезд exclusive; прошедшая дата не означает фактический выезд. Цвета не заменяют серверные статусы.' }
    features = service 'Действия и формы' { description 'Создание брони; редактирование объектов/номеров/аккаунтов; demo-payment и review-form. shared/ui выбирает фото/видео с устройства и отправляет FormData.' }
    gallery = service 'Галерея медиа' { description 'widgets/media-gallery: фотографии, alt-тексты и видео без автозапуска со звуком.' }
    stores = store 'Pinia' { description 'entities/session, guest-account, resort, booking: состояние интерфейса и загруженные записи; без прямого доступа представлений к localStorage.' }
    transport = service 'API transport' { description 'shared/api: асинхронный JSON/FormData контракт; app/main выбирает demo, browser HTTP+CSRF или native HTTP+Bearer по VITE_DATA_MODE и audience. shared/api/mobile-client сериализует refresh; app/providers/mobile связывает Keychain и авторизованные файлы.' }
    demo = service 'Браузерная демонстрация' { description 'app/providers/demo + demo-marketplace: каталог, заявки, отзывы, оплата/возврат, проверки версий и история. Фиксированный Asia/Almaty. Это имитация, не защита данных.' }
    local = store 'Локальные данные браузера' { description 'localStorage tynys:workspace:v2; sessionStorage гостя/сотрудника, demo-хеши паролей/OTP; IndexedDB для загруженных blobs. Отдельные origins имеют разные данные; общей БД между устройствами нет. Только вымышленные данные.' }
    http = service 'HTTP + CSRF' { description 'VITE_DATA_MODE=api: fetch, cookie-сессия и X-CSRFToken, JSON/FormData. /api и /media проксируются в локальной среде.' }
  }
  backend = system 'Django + DRF — общий API' {
    description 'Модульный transactional backend для web и двух native-клиентов; sandbox API опубликован на Vercel; PostgreSQL и приватные файлы в Supabase. Банковский CHARGE не проверен, checkout закрыт флагом готовности. Операционные ограничения: docs/backend.md и docs/verification.md.'
    api = service 'Общий /api/v1' { description 'config/urls: versioned /api/v1 и legacy /api вызывают одни DRF handlers. Browser cookie+CSRF либо проверенный guest/staff Bearer с разными namespaces; JSON/FormData и серверные permissions.' }
    auth = service 'Аккаунты и web-сессии' { description 'Staff User и отдельный GuestAccount по телефону. Cookie+CSRF, серверные password/OTP hashes, TTL/лимиты, одноразовые challenge, отзыв сессий при reset. Demo OTP только DEBUG+флаг; реальный SMS и native challenge transport ещё не реализованы.' }
    mobileAuth = service 'Native guest и staff credentials' { description 'booking/mobile_auth и staff_mobile_auth + identity: отдельные GuestDevice/StaffDevice, opaque access 15мин, guest-family 30дней/staff-family 12ч, refresh rotation/replay revoke. Guest Bearer не даёт staff-прав. Staff password/role/account-version/ownership changes отзывают доступ; invalid Bearer не откатывается к cookie.' }
    adminConsole = service 'Django Admin /django-admin/' { description 'booking.admin platform_admin_site: только active staff superuser, readonly модели, поиск/фильтры/счётчики и переходы в service-backed staff UI. Хеши, OTP и storage keys скрыты; login rate-limit. /admin/ перенаправляет сюда.' }
    profiles = service 'Гости, аватары и проживание' { description 'GuestProfile: контакт/история владельца и scoped staff view; profile UI требует GuestAccount, legacy browser history не выдаётся за вход. booking/directory: admin-only пагинация/поиск и отзыв доступа без изменения подтверждённого телефона. Avatar FK на MediaAsset; upload/delete только signed-in guest с аудитом. Оплаченная confirmed-бронь: not_arrived → in_house → checked_out; после заселения отмена недоступна. Staff notes с tenant scope/version и аудитом без содержимого; гостю не выдаются.' }
    catalog = service 'Каталог и профили' { description 'booking: санатории с обязательным account FK (PROTECT), физические номера, классы, категории, медиа-ссылки, обычные/скидочные тарифы, время заезда и IANA timezone. booking/availability: ограниченный месячный календарь по классу или конкретному номеру, только агрегаты без персональных данных.' }
    pricing = service 'Цены и возрастные правила' { description 'booking/pricing.py: RoomPricePeriod с PostgreSQL exclusion constraint; дневной расчёт, базовая цена вне периода, tariff children_under_three_free по решению сотрудника. Возраст на заезд, все гости входят во вместимость; snapshot фиксирует каждую ночь и политику. Это не государственное право на льготу.' }
    health = service 'Liveness / Readiness' { description 'config/health: процесс без БД и отдельный SELECT 1 с SQL timeout. Только ok/unavailable, no-store; не доказывает доступность S3/платежей и не заменяет SRE.' }
    holds = service 'Удержание до оплаты' { description 'booking/holds.py + expire_payment_holds: expiry по серверному времени, под блокировкой санатория; активный фонд защищён PostgreSQL. Supabase pg_cron раз в минуту вызывает защищённый /internal/payments/tick; expiry работает даже при закрытом банковском checkout.' }
    commission = service 'Комиссия платформы' { description 'commerce/commission.py: admin-only процент по санаторию, frozen estimate в заказе. Не является ledger, банковским split или выплатой.' }
    reservations = service 'Заявки и бронирования' { description 'booking/services.py: GuestAccount обязателен, контакты из профиля; pending удерживает номер до 15 минут до оплаты; оплата автоматически confirmed; истечение expired; отмена. Серверная цена, фиксированные условия/время заезда, idempotency, версии и транзакции.' }
    reviews = service 'Отзывы и модерация' { description 'booking: один отзыв владельца завершённой подтверждённой брони, текст/оценка/фото, решение и ответ сотрудника. Публичны только approved.' }
    media = service 'Файлы и доступ к медиа' { description 'media.py + media_access: FormData, MediaAsset с владельцем/purpose, валидация ссылок, image decode/EXIF strip и basic MP4/WebM. Квоты 24ч/100файлов, stable /api/media/files/:id и проверка публикации/владельца. Local range либо S3 signed redirect на 60с.' }
    maintenance = service 'Очистка и обслуживание' { description 'cleanup_media: dry-run по умолчанию, --delete удаляет только непривязанные metadata-backed uploads старше 24ч под owner locks. cleanup_mobile_sessions удаляет expired families. Расписание, storage reconciliation и restore проверка ещё не настроены.' }
    commerce = service 'Оплата и возврат — симулятор' { description 'commerce: DemoPayment/DemoRefund: оплата pending/legacy confirmed до заезда и expiry, атомарное оформление брони. Kaspi-themed demo без вызовов банка. >=48ч:100%; >=24ч:70%; иначе0%. Защита повторов, возврат в транзакции отмены.' }
    bankPayments = service 'Банковские провайдеры' { description 'PaymentAttempt/Event: одна попытка на бронь, bounded hold, frozen amount, actor-bound idempotency. Halyk sandbox и XPayment v1/v2 с разделением sandbox/production; production gate закрыт. Только независимая проверка заказа, аккаунта, суммы и валюты подтверждает бронь под resort lock. Callback/redirect не являются оплатой; поздние события идут в reconciliation. Подписанные XPayment delivery дедуплицируются в PostgreSQL. Реальная банковская приёмка не завершена.' }
    paymentJobs = service 'Durable payment jobs' { description 'PostgreSQL PaymentJob: lease/skip_locked, coalescing, bounded retry, dead-letter. Провайдер выбирается по сохранённой попытке; смена нового checkout не перенаправляет старые платежи. Create, verify, deactivate, refund/refund_verify. Network вне транзакций; неизвестный POST не повторяется. RefundRequest фиксирует намерение, только независимая сверка завершает возврат.' }
    receipts = service 'Демо-квитанции JSON / PDF' { description 'commerce/receipts.py: исходный снимок при оплате, отдельные сведения возврата, no-store и доступ владельцу/сотруднику. ReportLab + OFL Noto Sans. source=demo; настоящий чек от Kaspi не интегрирован.' }
    analytics = service 'Агрегаты аналитики' { description 'booking/analytics.py: PostgreSQL-агрегаты по датам событий в Asia/Almaty, сравнение периодов, нулевые интервалы, top500 по объектам/номерам. Источники demo/sandbox/production выбираются отдельно; учитываются только applied charge и verified refund. Net-поступления не являются прибылью.' }
    accounting = service 'Финансовые документы' { description 'commerce/accounting: глобальный accountant, scoped manager read-only, ручной expense register, grouped financial aggregates, PostgreSQL sequence под resort lock, snapshots, draft/released/voided. Акт и счёт-фактура автоматически после фактического выезда; PDF/XLSX по очищенным пользовательским шаблонам. Только неподписанные копии; ПКО не публикуется без кассового учёта.' }
    audit = service 'История изменений' { description 'booking Audit: before/after и актор записываются с мутацией в одной транзакции. Нет endpoint изменения журнала; DB-администратор всё ещё может менять БД.' }
  }
  database = store 'PostgreSQL' { description 'Каталог, web/native identity, guest profile/avatar, MediaAsset, брони/проживания, отзывы, demo-commerce и аудит. GiST запрещает пересечение pending/confirmed; unique защищает оплату. Тесты используют local PostgreSQL; Django подключён TLS verify-full через transaction pooler к отдельной private tynys_stage schema. Старый tynys сохранён. Runtime-таблицы, RLS включён, прямые anon/authenticated grants отозваны.' }
  files = store 'Приватные фото и видео' { description 'Local backend/private-media; Supabase private bucket tynys-private подключён; write/read/delete тестового JPEG проверены. Прямой object key не публикуется. Авторизованная выдача через API; signed S3 URL доступен обладателю до 60с. Vercel sandbox ограничен файлами 4 MB; direct upload, транскодирование и сверка хранилища ещё нужны.' }
  supabase = service 'Supabase sandbox' { description 'Seoul ap-northeast-2, Free/Nano. Django role tynys_stage без superuser/createdb/bypassrls, private schema и S3; credentials только server env. Не инфраструктура для реальных персональных данных. Supabase Auth и прямые клиентские записи не используются.' }
  halyk = service 'Halyk ePay — внешний sandbox' { description 'Общие опубликованные тестовые invoice credentials. OAuth/lookup/create recovery/deactivation проверены. Успешное CHARGE, callback delivery и реальный sandbox refund пока не подтверждены.' }
  xpayment = service 'XPayment — Kaspi Pay integration' { description 'Сторонний API api.xpayment.kz/v2 (beta) с совместимостью v1; не официальный Kaspi API. Server-only ключ, account/device/environment binding, HMAC webhook. Касса подключена владельцем, v2 read-only доступ проверен. Sandbox с отдельным ключом: облачные оплата, callback и полный/частичный возврат проверены; тестовый checkout включён, реальный gate закрыт. Один аккаунт не реализует split/выплаты санаториям; API чека не документирован.' }
  tiles = service 'OpenStreetMap' { description 'Leaflet запрашивает тайлы по HTTPS с attribution. При сбое доступны список и ручной выбор координат.' }
  hosting = service 'Vercel — два сайта' { description 'Public dist/site и staff dist/staff на отдельных проектах. Маршруты выбираются при сборке. LikeC4 не публикуется. /api проксируется в tynys-api.vercel.app; браузерные cookie остаются на origin сайта.' link https://vercel-site-puce-two.vercel.app 'Сайт' }
  staffHosting = service 'Адрес сотрудников' { description 'tynys-staff.vercel.app; отдельный сайт. API-сборка использует ту же Supabase БД через Django; native demo-сборки на iPhone не обновлялись.' link https://tynys-staff.vercel.app 'Кабинет' }
  accountant -> frontend.accountingPage 'Вся платформа: финансы и документы'
  accountant -> frontend.analyticsPage 'Показатели всех санаториев'
  accountant -> frontend.occupancy 'План размещения только для чтения'
  admin -> frontend.accountingPage 'Все доступные санатории'
  frontend.accountingPage -> frontend.transport 'accounting API / authorized downloads'
  frontend.guestProfile -> backend.accounting 'Только собственные released документы'
  backend.api -> backend.accounting 'Web cookie + CSRF, проверки роли/объекта'
  backend.reservations -> backend.accounting 'Черновики при recorded checkout'
  backend.accounting -> database 'Документы, реквизиты, последовательности'
  backend.accounting -> backend.audit 'Метаданные операции без реквизитов'
  backend.api -> backend.bankPayments 'Checkout/read/refresh и callback-сигналы'
  backend.bankPayments -> database 'Attempt/event и атомарное подтверждение'
  backend.bankPayments -> backend.paymentJobs 'Устойчивая очередь'
  backend.paymentJobs -> halyk 'OAuth + фиксированные HTTPS endpoints'
  backend.paymentJobs -> xpayment 'Bearer v1/v2 key + независимая GET-сверка'
  xpayment -> backend.bankPayments 'HMAC callback → durable dedupe → verify job'
  supabase -> backend.paymentJobs 'pg_cron / pg_net + Vault secret'
  guest -> frontend.discovery 'Категория и карта'
  guest -> frontend.profiles 'Даты, номер, тариф'
  guest -> frontend.bookingsPage 'Заявка, оплата, отмена, отзыв'
  guest -> frontend.guestProfile 'История, контакт и PDF'
  guest -> frontend.guestAuth 'Телефон и пароль'
  guest -> native 'Приложение гостя'
  manager -> nativeStaff 'Рабочее приложение'
  admin -> nativeStaff 'Управление платформой'
  nativeStaff -> backend.api 'Тот же scoped transactional API'
  nativeStaff -> backend.mobileAuth 'staff-mobile-auth + отдельный Keychain'
  native -> backend.api 'Guest Bearer / JSON / multipart'
  native -> backend.mobileAuth 'login / refresh / sessions'
  operator -> backend.adminConsole 'Superuser web session'
  backend.adminConsole -> database 'Только чтение и агрегаты'
  backend.adminConsole -> frontend.staffPage 'Действия через сервисный кабинет'
  backend.api -> backend.auth 'Web cookie / CSRF'
  backend.api -> backend.mobileAuth 'Guest / staff credentials без cookie fallback'
  backend.api -> backend.reservations 'Общие правила бронирования'
  backend.reservations -> backend.pricing 'Снимок цены под транзакционным lock'
  backend.pricing -> database 'Периоды и тарифы'
  backend.health -> database 'Readiness SELECT 1'
  backend.api -> backend.profiles 'Профиль и проживание'
  backend.api -> backend.catalog 'Каталог'
  backend.api -> backend.media 'Загрузка / чтение'
  backend.mobileAuth -> database 'Device families и token hashes'
  backend.mobileAuth -> backend.auth 'GuestAccount и auth-version'
  frontend.guestAuth -> frontend.transport 'guest-auth endpoints'
  frontend.guestProfile -> frontend.guestAuth 'Регистрация и восстановление'
  frontend.discovery -> frontend.localization 'Перевод интерфейса'
  frontend.staffPage -> frontend.occupancy 'План и карточка размещения'
  frontend.staffPage -> frontend.localization 'Перевод кабинета'
  manager -> frontend.analyticsPage 'Показатели своего санатория'
  admin -> frontend.analyticsPage 'Показатели платформы'
  admin -> frontend.staffPage 'Вся платформа'
  manager -> frontend.staffPage 'Свой санаторий'
  frontend.discovery -> frontend.profiles 'Выбор санатория'
  frontend.profiles -> frontend.gallery 'Фото и видео'
  frontend.profiles -> frontend.features 'Создание заявки'
  frontend.bookingsPage -> frontend.features 'Демо-оплата и отзыв'
  frontend.staffPage -> frontend.features 'Управление и модерация'
  frontend.discovery -> frontend.stores 'Каталог'
  frontend.profiles -> frontend.transport 'Профили и доступность'
  frontend.bookingsPage -> frontend.stores 'Собственные брони'
  frontend.bookingsPage -> frontend.transport 'Предпросмотр отмены'
  frontend.guestProfile -> frontend.transport 'Профили и защищённые квитанции'
  frontend.analyticsPage -> frontend.transport 'GET /analytics с фильтрами'
  frontend.staffPage -> frontend.stores 'Роль и данные'
  frontend.features -> frontend.transport 'Мутации и загрузки'
  frontend.stores -> frontend.transport 'Чтение и действия'
  frontend.transport -> frontend.demo 'Режим demo по умолчанию'
  frontend.transport -> frontend.http 'Режим api'
  frontend.demo -> frontend.local 'Состояние и история'
  frontend.http -> backend.api 'JSON/FormData, cookies + CSRF'
  frontend.discovery -> tiles 'Карта поиска'
  frontend.profiles -> tiles 'Положение санатория'
  frontend.features -> tiles 'Выбор координат'
  frontend.gallery -> backend.media 'Stable media reference; проверка доступа'
  backend.auth -> database 'Пользователи и сессии'
  backend.profiles -> database 'Контакт и история в разрешённой области'
  backend.profiles -> backend.reservations 'Отметки заезда и выезда'
  backend.profiles -> backend.media 'Avatar upload/remove и приватное чтение'
  backend.catalog -> database 'Каталог'
  backend.reservations -> backend.holds 'Истечение до повторной продажи'
  backend.reservations -> backend.commission 'Снимок комиссии нового заказа'
  backend.commerce -> backend.reservations 'Успешная demo-оплата оформляет бронь атомарно'
  backend.reservations -> database 'Блокировка санатория и защита пересечений'
  backend.reservations -> backend.commerce 'Отмена и возврат в одной транзакции'
  backend.commerce -> database 'Попытки платежа и возврат'
  backend.commerce -> backend.receipts 'Снимок при успешной demo-оплате'
  backend.receipts -> database 'Исходные поля и текущий возврат'
  backend.receipts -> backend.auth 'Владелец либо scoped staff'
  backend.analytics -> database 'Агрегация событий без выгрузки всего workspace'
  backend.analytics -> backend.auth 'Доступные санатории'
  backend.reviews -> backend.reservations 'Право на отзыв по завершённому проживанию'
  backend.reviews -> database 'Отзывы и агрегат рейтинга'
  backend.media -> backend.auth 'Доступ сотрудника к санаторию'
  backend.media -> backend.reviews 'Право гостя загрузить фото'
  backend.media -> files 'Проверенные файлы с UUID-именами'
  backend.media -> database 'Метаданные, владелец и квоты'
  backend.maintenance -> database 'Expired tokens / unreferenced assets'
  backend.maintenance -> files 'Контролируемая очистка'
  database -> supabase 'Private staging schema, TLS и migrations'
  files -> supabase 'Private bucket tynys-private; stable API references'
  backend.catalog -> backend.audit 'Изменение каталога'
  backend.reservations -> backend.audit 'Переходы брони'
  backend.reviews -> backend.audit 'Отзыв и модерация'
  backend.commerce -> backend.audit 'Demo-payment и demo-refund'
  backend.audit -> database 'Внутри транзакции операции'
  hosting -> frontend 'Отдаёт статическую сборку'
}
views {
  view index { title 'Тыныс: роли и платформа' include guest, admin, manager, accountant, operator, frontend, native, backend, database, files, tiles, hosting }
  view browser of frontend { title 'Vue / FSD / адаптеры данных' include frontend.*, guest, admin, manager, tiles }
  view api { title 'Общий backend: Web, Native, Django Admin и private media' include frontend.http, native, operator, backend.*, database, files, supabase }
  view mediaFlow { title 'Загрузка и защищённая выдача фото/видео' include guest, manager, frontend.features, frontend.guestProfile, frontend.gallery, backend.api, backend.auth, backend.mobileAuth, backend.media, backend.profiles, backend.maintenance, database, files, supabase }
  view bookingFlow { title 'Заявка, оплата и отмена' include guest, manager, frontend.bookingsPage, frontend.staffPage, backend.reservations, backend.commerce, backend.audit, database }
  view reporting { title 'История, квитанции и аналитика' include guest, manager, admin, frontend.guestProfile, frontend.analyticsPage, backend.profiles, backend.receipts, backend.analytics, database }
  view accountingFlow { title 'Бухгалтерия и документы' include accountant, admin, guest, frontend.accountingPage, frontend.guestProfile, backend.api, backend.accounting, backend.reservations, backend.audit, database }
  view publication { title 'Статический сайт и отдельно запускаемый API' include hosting, frontend, backend, files, tiles }
}
