  "dependencies": {
    "leaflet": "1.9.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "axe-core": "^4.14.0",
