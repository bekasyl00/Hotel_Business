  "description": "Map-first sanatorium booking prototype",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 4173",
    "test": "node --test && node scripts/check-fsd.mjs",
    "build": "npm run arch:sync && vite build",
    "arch:sync": "node scripts/architecture.mjs",
    "arch:check": "npm run arch:sync && likec4 validate architecture",
    "arch": "node scripts/arch-dev.mjs",
    "arch:build": "npm run arch:sync && likec4 build architecture -o dist/architecture",
    "dev": "vite --host 127.0.0.1 --port 4173",
    "preview": "vite preview --host 127.0.0.1 --port 4174"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bekasyl00/Hotel_Business.git"
  },
