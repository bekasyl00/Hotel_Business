{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:staff",
  "outputDirectory": "dist/staff",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://tynys-api.vercel.app/api/$1",
      "headers": {
        "Cache-Control": "private, no-store"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(staff|account|resorts|rooms|receipts)(/.*)?",
      "dest": "/index.html"
    },
    {
      "src": "/(profile|bookings)",
      "dest": "/index.html"
    }
  ]
}
