DEBUG=True
GUEST_AUTH_DEMO_OTP=True
# Temporary phone/password signup without SMS; phone remains unverified. Reset still requires SMS.
GUEST_AUTH_ALLOW_UNVERIFIED_REGISTRATION=False
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DATABASE_URL=postgresql://tynys:local-development-only@127.0.0.1:54329/tynys
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:4180,http://127.0.0.1:4180

# Supabase connection values belong only on the Django server; see docs/supabase.md.
DB_SCHEMA=public
DB_CONN_MAX_AGE=60
DB_TRANSACTION_POOLER=False
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/run/secrets/supabase-ca.crt
MEDIA_STORAGE=local
# MEDIA_STORAGE=supabase
# SUPABASE_S3_ENDPOINT=https://PROJECT.storage.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=REGION_FROM_DASHBOARD
# SUPABASE_S3_ACCESS_KEY_ID=SERVER_SIDE_ONLY
# SUPABASE_S3_SECRET_ACCESS_KEY=SERVER_SIDE_ONLY
# SUPABASE_STORAGE_BUCKET=tynys-private
STAFF_WORKSPACE_URL=http://127.0.0.1:4173/staff

# Bank sandbox: values are server-only. Never use VITE_* for credentials.
PAYMENT_PROVIDER=simulator
PAYMENTS_ALLOW_SIMULATOR=True
HALYK_EPAY_ENV=sandbox
HALYK_EPAY_PROTOCOL_VERIFIED=False
HALYK_EPAY_CLIENT_ID=
HALYK_EPAY_CLIENT_SECRET=
HALYK_EPAY_SHOP_ID=
HALYK_EPAY_TERMINAL_ID=
HALYK_EPAY_LOOKUP_GRANT=client_credentials
HALYK_EPAY_INVOICE_USERNAME=
HALYK_EPAY_INVOICE_PASSWORD=
HALYK_EPAY_INVOICE_PREFIX=
HALYK_EPAY_INVOICE_START=700000
HALYK_EPAY_INVOICE_END=709999
PAYMENTS_PUBLIC_API_ORIGIN=
PAYMENTS_PUBLIC_SITE_ORIGIN=
PAYMENTS_PUBLIC_STAFF_ORIGIN=
PAYMENTS_SCHEDULER_SECRET=

# Hosted sandbox request-body limit; 0 uses normal media limits locally.
MEDIA_UPLOAD_MAX_BYTES=0

# Server-only Fernet keyring, first key encrypts; retain older keys for existing documents.
DOCUMENT_DATA_ENCRYPTION_KEYS=
# Execute one durable create/verify job inline; scheduler still required.
PAYMENTS_INLINE_CHECKOUT=false
# Read-only Prometheus scrape credential. Generate locally; never put in VITE_*.
# Leave empty to disable /internal/metrics. Grafana Cloud Metrics Endpoint can use it.
METRICS_BEARER_TOKEN=
REQUEST_LOG_ENABLED=True
