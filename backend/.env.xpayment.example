# Server only. Copy to ignored backend/.env.xpayment and chmod 600.
# PAYMENTS_ENV_FILE can point to this file; process/main env takes precedence.
PAYMENT_PROVIDER=xpayment
XPAYMENT_API_VERSION=v2
XPAYMENT_ENV=sandbox
XPAYMENT_DEVICE_NAME=test
XPAYMENT_ENABLED=false
XPAYMENT_PROTOCOL_VERIFIED=false
XPAYMENT_SANDBOX_PROTOCOL_VERIFIED=false
# xapi_test_... for sandbox; xapi_... + production + actual device_name for live.
XPAYMENT_API_KEY=
# UUID user_id from the authenticated XPayment payment object; never an arbitrary local ID.
XPAYMENT_ACCOUNT_ID=
# Same independently generated >=32-character secret in Django and webhook subscription.
XPAYMENT_WEBHOOK_SECRET=
# Callback: https://<backend>/api/v1/payments/providers/xpayment/callback
# Configure an external scheduler for POST /internal/payments/tick separately.
